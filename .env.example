# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://guildmasters:guildmasters@localhost:5442/guildmasters"

# Wiki sync (scripts/sync-wiki.ts)
WIKI_API_URL="https://wiki.guildwars.com/api.php"
WIKI_REQUEST_DELAY_MS=1000
WIKI_USER_AGENT="GuildMasters/0.1 (https://github.com/your-repo; contact@example.com)"

# Scratch DB used only by `prisma migrate dev`/`migrate diff` (see README)
SHADOW_DATABASE_URL="postgresql://guildmasters:guildmasters@localhost:5442/shadow_check"

# Account that gets isAdmin=true automatically on registration (art moderation queue)
ADMIN_EMAIL=admin@example.com

# Kill-switch for the Kamadan (auction house): set to "false" to block new
# listings and bids. Any other value (or unset) = enabled.
MARKET_ENABLED=true

# Rarity distribution - used both for percentile classification and weighted
# booster draws. Don't need to sum to 1: they're renormalized automatically.
RARITY_SHARE_COMMON=0.45
RARITY_SHARE_UNCOMMON=0.25
RARITY_SHARE_RARE=0.15
RARITY_SHARE_EPIC=0.09
RARITY_SHARE_LEGENDARY=0.05
RARITY_SHARE_MYTHIC=0.01
