# Copy to /var/www/guildmasters/.env on the server (chmod 600), fill in real values.
# Read by docker-compose.prod.yml both for its own ${POSTGRES_PASSWORD}
# substitution and, via env_file, injected into the app container.

POSTGRES_PASSWORD=changeme
DATABASE_URL="postgresql://guildmasters:changeme@db:5432/guildmasters"

ADMIN_EMAIL="demo@keyf.app"

# Kill-switch for the Kamadan (auction house): set to "false" to block new
# listings and new bids/buyouts. Existing auctions stay browsable and can
# still be cancelled or completed. Any other value (or unset) = enabled.
MARKET_ENABLED=true

WIKI_API_URL="https://wiki.guildwars.com/api.php"
WIKI_REQUEST_DELAY_MS=1000
WIKI_USER_AGENT="GuildMasters/0.1 (https://github.com/pCyril/gwtcg; contact@example.com)"

RARITY_SHARE_COMMON=0.45
RARITY_SHARE_UNCOMMON=0.25
RARITY_SHARE_RARE=0.15
RARITY_SHARE_EPIC=0.09
RARITY_SHARE_LEGENDARY=0.05
RARITY_SHARE_MYTHIC=0.01
