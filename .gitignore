# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# ...except the checked-in template (placeholders only, no real secrets)
!deploy/.env.production.example

# vercel
.vercel

# user-submitted art (src/lib/game/artSubmission.ts) - runtime data, persisted
# via a Docker volume in production, not part of the source tree
/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# card art: only the two images the app needs are tracked (card back, booster
# pack); the other files here are unused samples of unclear provenance
/public/card-art/*
!/public/card-art/card-back.jpg
!/public/card-art/pack-wrapper.webp
